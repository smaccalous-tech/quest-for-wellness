rules_version = '2';

// Cloud Storage rules for original Qest4 PDFs, stored at reports/{reportId}/original.pdf.
// Deploy: Firebase console → Storage → Rules (paste this file), or `firebase deploy --only storage`.
service firebase.storage {
  match /b/{bucket}/o {

    function verified() { return request.auth != null && request.auth.token.email_verified == true; }
    function myEmail()  { return request.auth.token.email.lower(); }
    function isAdmin()  { return verified() && myEmail() == 'questforwellness22@gmail.com'; }
    function report(reportId) {
      return firestore.get(/databases/(default)/documents/reports/$(reportId)).data;
    }

    match /reports/{reportId}/{fileName} {
      allow read: if isAdmin()
        || (verified() && report(reportId).status == 'published' && report(reportId).clientEmail == myEmail());
      allow create, update: if isAdmin()
        && request.resource.contentType == 'application/pdf'
        && request.resource.size < 20 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
